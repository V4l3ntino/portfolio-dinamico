---
import '../styles/global.css';

const slideVersion = '20260723-2208';

const projects = [
  {
    id: 'tiendaropa',
    name: 'tienda ropa',
    type: 'Ecommerce de moda',
    summary: 'Prueba de ecommerce completo: escaparate, carrito, checkout y un panel admin pensado para gestionar productos sin tocar código.',
    slides: [
      '/projects/slides/tiendaropa-01.png',
      '/projects/slides/tiendaropa-02.png',
      '/projects/slides/tiendaropa-03.png'
    ],
    accent: '#C54C4E',
    url: 'https://tienda-ropa-weld.vercel.app',
    stack: ['FastAPI', 'SQLite', 'JavaScript', 'Docker', 'Integración con IA'],
    metrics: ['Frontend + backend', 'Admin real', 'Excel'],
    proof: ['Catálogo con filtros por categoría, marca, talla, color, precio y stock', 'Gestión visual de productos con subida local de imágenes', 'Dashboard con pedidos, clientes, carritos y productos']
  },
  {
    id: 'gestorusuarios',
    name: 'Makito APP',
    type: 'Gestión interna PRL',
    summary: 'Sistema interno para ordenar usuarios, trabajadores y expedientes, con exportaciones listas para uso administrativo.',
    slides: [
      '/projects/slides/gestorusuarios-01.png',
      '/projects/slides/gestorusuarios-02.png',
      '/projects/slides/gestorusuarios-03.png'
    ],
    accent: '#2457C5',
    url: 'https://gestorusuarios-demo-front.vercel.app',
    stack: ['Next.js', 'Django REST', 'SQLite', 'Tailwind', 'Vercel'],
    metrics: ['Next + Django', 'Dashboard', 'DOCX/PDF'],
    proof: ['Dashboard con expedientes, filtros, selección múltiple y ordenación', 'Catálogos de usuarios, operarios, puestos, lugares, agentes y causas', 'Generación de fichas de accidente y exportación de expedientes']
  },
  {
    id: 'crm',
    name: 'crm',
    type: 'Presupuestos comerciales',
    summary: 'Herramienta comercial para crear presupuestos, seguir oportunidades y convertir datos de clientes en decisiones rápidas.',
    slides: [
      '/projects/slides/crm-01.png',
      '/projects/slides/crm-02.png',
      '/projects/slides/crm-03.png'
    ],
    accent: '#286D88',
    url: 'https://crm-presupuestos.vercel.app',
    stack: ['FastAPI', 'IndexedDB', 'Chart.js', 'DeepInfra', 'Excel/PDF'],
    metrics: ['Pipeline', 'PDF/Excel', 'Chat con IA'],
    proof: ['Registro de clientes y catálogo de servicios plantillables', 'Presupuestos con líneas, IVA, estados, duplicado y filtros', 'Gráficos comerciales, chat lateral y resúmenes con IA']
  }
];

const services = [
  'Interfaces modernas',
  'Backends y APIs',
  'Automatización e IA'
];

const skillGroups = [
  {
    title: 'Frontend',
    items: ['Astro', 'Next.js', 'JavaScript', 'Tailwind', 'Responsive UI']
  },
  {
    title: 'Backend',
    items: ['FastAPI', 'Django REST', 'SQLite', 'Auth', 'APIs']
  },
  {
    title: 'Producto',
    items: ['Admin panels', 'PDF/Excel', 'Dashboards', 'Deploy', 'IA aplicada']
  }
];

const career = [
  {
    title: 'Prácticas en Hispatec',
    place: 'Hispatec',
    period: '2025 · 4 meses',
    description: 'Última etapa en empresa, trabajando durante cuatro meses en un entorno profesional donde reforcé mi criterio técnico, la organización del código y la forma de colaborar en proyectos reales.'
  },
  {
    title: 'Mi primer contrato de trabajo',
    place: 'Makito',
    period: '2024 · 6 meses',
    description: 'Contrato de seis meses donde participé en aplicaciones reales, entendiendo mejor el ritmo de producto, las mejoras continuas y el valor de entregar funcionalidades útiles y mantenibles.'
  },
  {
    title: 'Prácticas en Makito',
    place: 'Makito',
    period: 'Abril 2023 - Jun 2023',
    description: 'Primer contacto fuerte con proyectos de empresa: automatizaciones en Java y Spring Boot, herramientas internas con Python y Django, y aprendizaje práctico creando APIs REST.'
  },
  {
    title: 'Inicio en el Grado Superior',
    place: 'Desarrollo de Aplicaciones Web',
    period: '2023 - 2024',
    description: 'Base técnica donde empecé a construir criterio como desarrollador: programación orientada a objetos, bases de datos, SQL y primeros proyectos con Java y Spring Boot.'
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portfolio freelance con proyectos desplegados y tecnologías dominadas." />
    <title>Portfolio freelance | Proyectos desplegados</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <nav class="topbar" aria-label="Principal">
          <a class="brand" href="#top" aria-label="Inicio"><span></span> Valentino | Full-stack Portfolio</a>
          <div>
            <a href="#skills">Stack</a>
            <a href="#trayectoria">Trayectoria</a>
            <a href="#proyectos">Work</a>
            <a href="#contacto">Contact</a>
          </div>
        </nav>

        <div class="heroGrid" id="top">
          <div class="heroCopy">
            <figure class="heroAvatar" aria-label="Foto de Valentino Hontar">
              <img src="/avatar-valentino.jpg" alt="Valentino Hontar" width="240" height="240" />
            </figure>
            <p class="eyebrow">Freelance full-stack developer</p>
            <h1 id="hero-title">Hola, soy <span class="typingName">Valentino</span></h1>
            <p class="lead">Desarrollo interfaces, paneles de administración y aplicaciones web completas con demos desplegadas que se pueden abrir, probar y enseñar.</p>
            <div class="heroActions">
              <a class="btn primary" href="#proyectos">Ver proyectos</a>
              <a class="btn secondary" href="#skills">Tecnologías</a>
            </div>
          </div>

          <div class="deskScene" aria-label="Escena de portfolio web">
            <div class="monitor">
              <div class="monitorTop">
                <span></span><span></span><span></span>
              </div>
              <div class="codeLine wide"></div>
              <div class="codeLine mid"></div>
              <div class="codeLine short"></div>
              <div class="terminal">
                <strong>3 proyectos desplegados</strong>
                <span>ecommerce / crm / gestorUsuarios</span>
              </div>
            </div>
            <div class="speaker left"></div>
            <div class="speaker right"></div>
            <div class="tower">
              <span></span>
              <span></span>
            </div>
            <div class="keyboard"></div>
            <div class="mouse"></div>
            <div class="desk"></div>
          </div>
        </div>
      </section>

      <section class="services" aria-label="Servicios">
        {services.map((service) => <span>{service}</span>)}
      </section>

      <section class="section skillsSection" id="skills">
        <div class="sectionHead">
          <p class="eyebrow">Stack que domino</p>
          <h2>Tecnologías aplicadas en proyectos reales</h2>
          <p>No es una lista decorativa: cada tecnología aparece porque está usada en una demo desplegada, con flujos completos y problemas de negocio resueltos.</p>
        </div>
        <div class="skillsGrid">
          {skillGroups.map((group) => (
            <article>
              <h3>{group.title}</h3>
              <div>
                {group.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section timelineSection" id="trayectoria">
        <div class="sectionHead">
          <p class="eyebrow">Trayectoria</p>
          <h2>Experiencia que sostiene los proyectos</h2>
          <p>Un recorrido corto y directo: formación, prácticas y trabajo real en empresas donde he aprendido a construir con criterio y orientación a producto.</p>
        </div>

        <div class="timeline">
          {career.map((step) => (
            <article class="timelineItem">
              <div class="timelineDot"></div>
              <div class="timelineContent">
                <div class="timelineMeta">
                  <div>
                    <h3>{step.title}</h3>
                    <span>{step.place}</span>
                  </div>
                  <time>{step.period}</time>
                </div>
                <p>{step.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section projectsSection" id="proyectos">
        <div class="sectionHead">
          <p class="eyebrow">Pruebas desplegadas</p>
          <h2>Tres proyectos que demuestran lo que puedo construir</h2>
          <p>Cada proyecto enseña una capacidad concreta: vender online, gestionar ventas o digitalizar procesos internos. Todos tienen demo pública y una base técnica explicable a cliente.</p>
        </div>

        <div class="projectRail">
          {projects.map((project, index) => (
            <article class="projectCard" id={project.id} style={`--accent:${project.accent}`} data-project-card>
              <div class="projectVisual" data-slider>
                <div class="projectSlides" aria-label={`Capturas de ${project.name}`}>
                  {project.slides.map((slide, slideIndex) => (
                    <img
                      src={`${slide}?v=${slideVersion}`}
                      alt={`Captura ${slideIndex + 1} de ${project.name}`}
                      loading={index === 0 && slideIndex === 0 ? 'eager' : 'lazy'}
                      class={slideIndex === 0 ? 'is-active' : ''}
                    />
                  ))}
                </div>
                <button
                  type="button"
                  class="slideArrow slideArrowPrev"
                  aria-label={`Ver captura anterior de ${project.name}`}
                  data-slide-prev
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  type="button"
                  class="slideArrow slideArrowNext"
                  aria-label={`Ver captura siguiente de ${project.name}`}
                  data-slide-next
                >
                  <span aria-hidden="true">›</span>
                </button>
                <div class="slideCounter" aria-label={`Cambiar captura de ${project.name}`}>
                  {project.slides.map((_, slideIndex) => (
                    <button
                      type="button"
                      class={slideIndex === 0 ? 'is-active' : ''}
                      aria-label={`Ver captura ${slideIndex + 1} de ${project.name}`}
                      aria-pressed={slideIndex === 0 ? 'true' : 'false'}
                      data-slide-dot={slideIndex}
                    ></button>
                  ))}
                </div>
              </div>
              <div class="projectBody">
                <div class="projectTitle">
                  <span>{project.type}</span>
                  <h3>{project.name}</h3>
                </div>
                <p>{project.summary}</p>
                <div class="stack">
                  {project.stack.map((item) => <span>{item}</span>)}
                </div>
                <div class="proofGrid">
                  {project.metrics.map((item) => <strong>{item}</strong>)}
                </div>
                <ul>
                  {project.proof.map((item) => <li>{item}</li>)}
                </ul>
                <a class="projectLink" href={project.url} target="_blank" rel="noreferrer">Abrir demo desplegada</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section method" id="metodo">
        <div class="sectionHead">
          <p class="eyebrow">Cómo convierto ideas en productos</p>
          <h2>De una idea inicial a una demo lista para enseñar</h2>
        </div>
        <div class="methodGrid">
          <article>
            <span>01</span>
            <h3>Entiendo el objetivo</h3>
            <p>Convierto una idea poco definida en funcionalidades concretas, priorizando lo que aporta valor desde el primer uso.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Diseño y desarrollo</h3>
            <p>Construyo una interfaz clara, responsive y conectada a datos reales, cuidando tanto la experiencia como la parte técnica.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Entrego y documento</h3>
            <p>Dejo el proyecto desplegado, probado y explicado para que puedas enseñarlo, validarlo o seguir desarrollándolo.</p>
          </article>
        </div>
      </section>

      <section class="contact" id="contacto">
        <div>
          <p class="eyebrow">Disponible para nuevos proyectos</p>
          <h2>¿Tienes una idea y quieres verla funcionando?</h2>
          <p>Puedo ayudarte a convertirla en una demo web profesional, con diseño cuidado, funcionalidades reales y una entrega lista para presentar.</p>
        </div>
        <a class="btn primary" href="https://wa.me/34603112496" target="_blank" rel="noreferrer">Contactar por WhatsApp</a>
      </section>
    </main>

    <script>
      const nodes = document.querySelectorAll<HTMLElement>('[data-target]');
      const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
      const sliders = document.querySelectorAll<HTMLElement>('[data-slider]');

      nodes.forEach((node) => {
        node.addEventListener('click', () => {
          const target = node.dataset.target;
          if (target) document.getElementById(target)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      }, { threshold: 0.18 });

      cards.forEach((card) => observer.observe(card));

      const shouldAutoSlide = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      sliders.forEach((slider, sliderIndex) => {
        const slides = Array.from(slider.querySelectorAll<HTMLImageElement>('.projectSlides img'));
        const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-slide-dot]'));
        const prevButton = slider.querySelector<HTMLButtonElement>('[data-slide-prev]');
        const nextButton = slider.querySelector<HTMLButtonElement>('[data-slide-next]');
        if (slides.length < 2) return;

        let activeSlide = 0;
        let intervalId: number | undefined;

        const showSlide = (nextSlide: number) => {
          slides[activeSlide].classList.remove('is-active');
          dots[activeSlide]?.classList.remove('is-active');
          dots[activeSlide]?.setAttribute('aria-pressed', 'false');
          activeSlide = nextSlide;
          slides[activeSlide].classList.add('is-active');
          dots[activeSlide]?.setAttribute('aria-pressed', 'true');
          dots[activeSlide]?.classList.add('is-active');
        };

        const startAutoSlide = () => {
          if (!shouldAutoSlide) return;
          intervalId = window.setInterval(() => {
            showSlide((activeSlide + 1) % slides.length);
          }, 3600 + sliderIndex * 450);
        };

        const restartAutoSlide = () => {
          if (intervalId) window.clearInterval(intervalId);
          startAutoSlide();
        };

        prevButton?.addEventListener('click', () => {
          showSlide((activeSlide - 1 + slides.length) % slides.length);
          restartAutoSlide();
        });

        nextButton?.addEventListener('click', () => {
          showSlide((activeSlide + 1) % slides.length);
          restartAutoSlide();
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const targetSlide = Number(dot.dataset.slideDot);
            if (Number.isNaN(targetSlide) || targetSlide === activeSlide) return;
            showSlide(targetSlide);
            restartAutoSlide();
          });
        });

        startAutoSlide();
      });
    </script>
  </body>
</html>
